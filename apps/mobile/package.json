  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~57.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
